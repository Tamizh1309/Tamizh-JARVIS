# Tamizh JARVIS Configuration

# Application
APP_NAME="Tamizh JARVIS"
APP_ENV=development
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO

# AI Providers
# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local AI (Ollama or OpenAI-compatible endpoint)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3

# Active Provider: "gemini", "local", "fallback", or "auto"
DEFAULT_AI_PROVIDER=auto

# Database
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db

# Security
SECURITY_REQUIRE_APPROVAL_FOR_HIGH_RISK=true

# CORS Allowed Origins (Comma-separated list of allowed web origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tamizh1309.github.io
